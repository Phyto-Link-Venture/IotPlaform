# Copy to .env and fill in. NEVER commit the real .env.

# --- Database ---
POSTGRES_DB=iotplatform
POSTGRES_USER=iotplatform
POSTGRES_PASSWORD=change-me

# --- API ---
ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=iotplatform;Username=iotplatform;Password=change-me
Jwt__SigningKey=generate-a-long-random-secret-at-least-32-chars
Jwt__Issuer=IoTPlatform
Jwt__Audience=IoTPlatform

# --- MQTT ---
Mqtt__Host=localhost
Mqtt__Port=1883
Mqtt__Username=
Mqtt__Password=

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
