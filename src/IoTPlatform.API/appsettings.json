{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=iotplatform;Username=iotplatform;Password=postgres"
  },
  "Jwt": {
    "Issuer": "IoTPlatform",
    "Audience": "IoTPlatform",
    "SigningKey": "",
    "AccessTokenMinutes": 60,
    "RefreshTokenDays": 7
  },
  "Mqtt": {
    "Host": "localhost",
    "Port": 1883,
    "Username": "",
    "Password": "",
    "ClientId": "iotplatform-api",
    "TelemetryTopic": "devices/+/telemetry",
    "CommandTopicTemplate": "devices/{deviceKey}/commands",
    "Enabled": true
  },
  "Cors": {
    "Origins": [ "http://localhost:3000" ]
  },
  "AllowedHosts": "*"
}
